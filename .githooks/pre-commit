#!/usr/bin/env bash
# Git pre-commit hook for TrackDeck
# Ensures Fish shell completions are synchronized and syntactically valid whenever CLI is modified.

set -e

# Detect if cli.py or completions.py is staged
STAGED_CLI_FILES=$(git diff --cached --name-only | grep -E '^track_deck/(cli|completions)\.py$' || true)

if [ -n "$STAGED_CLI_FILES" ]; then
    echo "[*] Detected changes in CLI files: $STAGED_CLI_FILES"
    echo "[*] Verifying & updating Fish shell completions..."

    PY_BIN="${HOME}/Applications/StemDeck/python/bin/python3"
    if [ ! -x "$PY_BIN" ]; then
        PY_BIN="python3"
    fi

    # Run trackdeck completion --install to keep completions up to date
    PYTHONPATH="." "$PY_BIN" -c "
from track_deck.completions import install_fish_completions
ok, msg = install_fish_completions()
if not ok:
    print(msg)
    exit(1)
"

    # Validate syntax if fish is installed
    if command -v fish >/dev/null 2>&1; then
        FISH_FILE="${HOME}/.config/fish/completions/trackdeck.fish"
        if [ -f "$FISH_FILE" ]; then
            fish -n "$FISH_FILE" || {
                echo "[!] Error: Fish syntax check failed for $FISH_FILE"
                exit 1
            }
        fi
    fi

    echo "[+] Fish completions synchronized and validated successfully."
fi

exit 0
